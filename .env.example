# Local-first; deterministic simulated demonstration by default.
HOST=127.0.0.1
PORT=8787
GUARDIAN_DB=runtime/guardian.db

# Optional local Ollama inference (only used when explicitly selected in UI)
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen2.5:7b

# Optional Meta Model API reasoning (disabled until explicit opt-in)
# MODEL_API_KEY=store_in_environment_not_git
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1
ALLOW_EXTERNAL_META=false
